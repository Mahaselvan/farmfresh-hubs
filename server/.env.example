# ==============================================================================
# FARMFRESH HUBS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Placeholders only. NEVER commit real production credentials or API secrets.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Replica Set recommended for full multi-document ACID transactions)
MONGO_URI=mongodb://localhost:27017/farmfresh

# Authentication (JSON Web Tokens)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Payment Gateway (Razorpay Sandbox / Test Mode credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Client Origin (CORS Allowed Origin)
CLIENT_ORIGIN=http://localhost:5173

# Reverse Proxy Trust Configuration (options: "false", integer hops like "1", or subnet like "loopback")
TRUST_PROXY=false
